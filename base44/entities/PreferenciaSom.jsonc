{
  "name": "PreferenciaSom",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "som": {
      "type": "string",
      "default": "suave",
      "description": "Som das notificacoes no computador. Aceita som da galeria (custom:<id>)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "volume": {
      "type": "number",
      "default": 60
    },
    "som_chat": {
      "type": "string",
      "default": "mensagem",
      "description": "Som das mensagens no computador. Aceita som da galeria (custom:<id>)"
    },
    "chat_ativo": {
      "type": "boolean",
      "default": true
    },
    "volume_chat": {
      "type": "number",
      "default": 60
    },
    "notificar_email": {
      "type": "boolean",
      "default": true,
      "description": "Receber e-mail quando alguém me mencionar no chat"
    },
    "email_todas": {
      "type": "boolean",
      "default": false,
      "description": "Receber e-mail de todas as mensagens dos canais que participo"
    },
    "notificar_navegador": {
      "type": "boolean",
      "default": false,
      "description": "Mostrar notificação do navegador no computador"
    },
    "som_celular": {
      "type": "string",
      "description": "Som das notificacoes no celular"
    },
    "ativo_celular": {
      "type": "boolean",
      "description": "Som das notificacoes ligado no celular"
    },
    "volume_celular": {
      "type": "number",
      "description": "Volume das notificacoes no celular (0-100)"
    },
    "som_chat_celular": {
      "type": "string",
      "description": "Som das mensagens no celular"
    },
    "chat_ativo_celular": {
      "type": "boolean",
      "description": "Som das mensagens ligado no celular"
    },
    "volume_chat_celular": {
      "type": "number",
      "description": "Volume das mensagens no celular (0-100)"
    },
    "notificar_navegador_celular": {
      "type": "boolean",
      "default": false,
      "description": "Mostrar notificacao do navegador no celular"
    }
  },
  "required": [
    "usuario_id"
  ]
}
