{
  "name": "Conteudo",
  "type": "object",
  "properties": {
    "modelo_id": {
      "type": "string",
      "description": "Modelo dona deste conteudo"
    },
    "titulo": { "type": "string" },
    "secoes": {
      "type": "array",
      "description": "Blocos de conteudo da modelo. O formato de dentro ainda esta sendo definido.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "titulo": { "type": "string" },
          "descricao": { "type": "string" },
          "itens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "titulo": { "type": "string" },
                "texto": { "type": "string" },
                "valor": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "tabela_precos": {
      "type": "array",
      "description": "Tabela de precos da modelo, separada em abas. Cada aba tem nome (definido pelo admin) e os seus itens com tres valores: minimo, normal e maximo",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nome": { "type": "string", "description": "Nome da aba, livre para o admin editar" },
          "itens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "item": { "type": "string", "description": "O que esta sendo vendido" },
                "minimo": { "type": "number", "description": "Preco minimo, em reais (null quando vazio)" },
                "normal": { "type": "number", "description": "Preco normal, em reais (null quando vazio)" },
                "maximo": { "type": "number", "description": "Preco maximo, em reais (null quando vazio)" }
              }
            }
          }
        }
      }
    },
    "pastas": {
      "type": "array",
      "description": "Pastas do conteudo da modelo (so nome e id). Os itens ficam em \"itens\" e apontam para as pastas",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nome": { "type": "string" },
          "itens": {
            "type": "array",
            "description": "Formato antigo, quando o item morava dentro da pasta. Mantido para nao perder dado velho",
            "items": { "type": "object" }
          }
        }
      }
    },
    "itens": {
      "type": "array",
      "description": "Itens do conteudo; cada item diz em quais pastas aparece",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nome": { "type": "string", "description": "Sempre vazio hoje; mantido por compatibilidade" },
          "imagem_url": { "type": "string", "description": "Imagem do item (obrigatoria)" },
          "tipo": { "type": "string", "enum": ["video", "foto", "audio"] },
          "duracao_seg": { "type": "number", "description": "Duracao em segundos; usado em video e audio" },
          "data": { "type": "string", "description": "Data do item, no formato AAAA-MM-DD" },
          "descricao": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Tags sempre em MAIUSCULA" },
          "pastas": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ids das pastas onde o item aparece (pelo menos uma)"
          },
          "preco_minimo": { "type": "number", "description": "Preco minimo do item, em reais (null quando vazio)" },
          "preco_normal": { "type": "number", "description": "Preco normal do item, em reais (null quando vazio)" },
          "preco_maximo": { "type": "number", "description": "Preco maximo do item, em reais (null quando vazio)" }
        }
      }
    },
    "arquivado": {
      "type": "boolean",
      "default": false,
      "description": "Segue a modelo: arquivada ela, o conteudo tambem fica arquivado"
    },
    "arquivado_em": {
      "type": "string",
      "format": "date-time"
    },
    "atualizado_por": { "type": "string" },
    "atualizado_por_nome": { "type": "string" }
  },
  "required": ["modelo_id"]
}
