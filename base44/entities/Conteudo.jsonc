{
  "name": "Conteudo",
  "type": "object",
  "properties": {
    "modelo_id": {
      "type": "string",
      "description": "Modelo dona deste conteudo"
    },
    "titulo": { "type": "string" },
    "secoes": {
      "type": "array",
      "description": "Blocos de conteudo da modelo. O formato de dentro ainda esta sendo definido.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "titulo": { "type": "string" },
          "descricao": { "type": "string" },
          "itens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "titulo": { "type": "string" },
                "texto": { "type": "string" },
                "valor": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "arquivado": {
      "type": "boolean",
      "default": false,
      "description": "Segue a modelo: arquivada ela, o conteudo tambem fica arquivado"
    },
    "arquivado_em": {
      "type": "string",
      "format": "date-time"
    },
    "atualizado_por": { "type": "string" },
    "atualizado_por_nome": { "type": "string" }
  },
  "required": ["modelo_id"]
}
