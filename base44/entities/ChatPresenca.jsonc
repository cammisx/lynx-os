{
  "name": "ChatPresenca",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "canal_id": {
      "type": "string"
    },
    "ultimo_visto_em": {
      "type": "string"
    },
    "digitando_em": {
      "type": "string"
    }
  },
  "required": [
    "usuario_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}