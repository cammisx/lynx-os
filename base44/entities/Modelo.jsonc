{
  "name": "Modelo",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "chatters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "usuario_id": {
            "type": "string"
          },
          "usuario_nome": {
            "type": "string"
          },
          "identificador": {
            "type": "string"
          }
        }
      }
    },
    "arquivada": {
      "type": "boolean",
      "default": false
    },
    "arquivada_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "nome"
  ]
}