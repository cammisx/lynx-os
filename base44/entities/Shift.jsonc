{
  "name": "Shift",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "usuario_nome": {
      "type": "string"
    },
    "modelo_id": {
      "type": "string"
    },
    "modelo_nome": {
      "type": "string"
    },
    "pagina_nome": {
      "type": "string"
    },
    "inicio": {
      "type": "string",
      "format": "date-time"
    },
    "fim": {
      "type": "string",
      "format": "date-time"
    },
    "inicio_real": {
      "type": "string",
      "format": "date-time"
    },
    "fim_real": {
      "type": "string",
      "format": "date-time"
    },
    "aceite": {
      "type": "string",
      "enum": [
        "pendente",
        "aceito",
        "recusado",
        "nao_confirmado"
      ],
      "enumColors": [
        "blue",
        "green",
        "red",
        "gray"
      ],
      "default": "pendente"
    },
    "aceite_em": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_recusa": {
      "type": "string"
    },
    "avulso": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "agendado",
        "em_andamento",
        "concluido",
        "cancelado"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "red"
      ],
      "default": "agendado"
    },
    "repeticao": {
      "type": "string",
      "enum": [
        "nenhuma",
        "semanal",
        "quinzenal"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple"
      ],
      "default": "nenhuma"
    },
    "dias_semana": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "repetir_ate": {
      "type": "string",
      "format": "date"
    },
    "ajustes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "inicio": {
            "type": "string",
            "format": "date-time"
          },
          "fim": {
            "type": "string",
            "format": "date-time"
          },
          "solicitacao_id": {
            "type": "string"
          },
          "chatter_id": {
            "type": "string"
          }
        }
      }
    },
    "cancelamentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          },
          "solicitacao_id": {
            "type": "string"
          },
          "chatter_id": {
            "type": "string"
          },
          "cancelado_em": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "usuario_id",
    "inicio",
    "fim"
  ]
}