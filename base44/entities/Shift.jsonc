{
  "name": "Shift",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "usuario_nome": {
      "type": "string"
    },
    "modelo_id": {
      "type": "string"
    },
    "modelo_nome": {
      "type": "string"
    },
    "pagina_nome": {
      "type": "string"
    },
    "inicio": {
      "type": "string",
      "format": "date-time"
    },
    "fim": {
      "type": "string",
      "format": "date-time"
    },
    "inicio_real": {
      "type": "string",
      "format": "date-time"
    },
    "fim_real": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "agendado",
        "em_andamento",
        "concluido",
        "cancelado"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "red"
      ],
      "default": "agendado"
    },
    "repeticao": {
      "type": "string",
      "enum": [
        "nenhuma",
        "semanal",
        "quinzenal"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple"
      ],
      "default": "nenhuma"
    },
    "dias_semana": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "repetir_ate": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "usuario_id",
    "inicio",
    "fim"
  ]
}