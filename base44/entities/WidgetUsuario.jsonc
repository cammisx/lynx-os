{
  "name": "WidgetUsuario",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "turno",
        "paginas"
      ],
      "enumColors": [
        "orange",
        "purple"
      ],
      "default": "turno"
    },
    "icone_x": {
      "type": "number"
    },
    "icone_y": {
      "type": "number"
    },
    "painel_x": {
      "type": "number"
    },
    "painel_y": {
      "type": "number"
    },
    "aberto": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "usuario_id",
    "tipo"
  ],
  "rls": {
    "create": {
      "data.usuario_id": "{{user.id}}"
    },
    "read": {
      "data.usuario_id": "{{user.id}}"
    },
    "update": {
      "data.usuario_id": "{{user.id}}"
    },
    "delete": {
      "data.usuario_id": "{{user.id}}"
    }
  }
}