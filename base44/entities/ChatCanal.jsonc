{
  "name": "ChatCanal",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "geral",
        "modelo",
        "privado",
        "grupo"
      ],
      "enumColors": [
        "orange",
        "purple",
        "blue",
        "green"
      ],
      "default": "privado"
    },
    "modelo_id": {
      "type": "string"
    },
    "participantes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criado_por": {
      "type": "string"
    },
    "ultima_mensagem_em": {
      "type": "string"
    },
    "ultima_mensagem_preview": {
      "type": "string"
    },
    "ultima_mensagem_autor": {
      "type": "string"
    }
  },
  "required": [
    "tipo"
  ],
  "rls": {
    "create": {
      "data.criado_por": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.participantes": "{{user.id}}"
        },
        {
          "data.criado_por": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}