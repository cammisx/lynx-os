{
  "name": "Notificacao",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "mensagem": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "turno_esquecido",
        "novo_shift",
        "turno_recusado",
        "turno_pendente"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "red",
        "orange"
      ],
      "default": "turno_esquecido"
    },
    "shift_id": {
      "type": "string"
    },
    "ocorrencia_data": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "resolvida"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "pendente"
    },
    "resposta": {
      "type": "string"
    },
    "lida": {
      "type": "boolean",
      "default": false
    },
    "criado_por_automacao": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "usuario_id",
    "titulo",
    "mensagem",
    "tipo"
  ]
}