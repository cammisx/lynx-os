{
  "name": "Notificacao",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "mensagem": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "turno_esquecido",
        "novo_shift",
        "turno_recusado",
        "turno_pendente",
        "venda_pendente",
        "folga_pendente",
        "ajuste_ponto_pendente",
        "horario_disponivel"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "red",
        "orange",
        "purple",
        "teal",
        "pink",
        "purple"
      ],
      "default": "turno_esquecido"
    },
    "shift_id": {
      "type": "string"
    },
    "venda_id": {
      "type": "string"
    },
    "venda_ids": {
      "type": "string"
    },
    "folga_id": {
      "type": "string"
    },
    "ajuste_ponto_id": {
      "type": "string"
    },
    "solicitacao_id": {
      "type": "string"
    },
    "modelo_id": {
      "type": "string"
    },
    "modelo_nome": {
      "type": "string"
    },
    "turno_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "turno_fim": {
      "type": "string",
      "format": "date-time"
    },
    "ocorrencia_data": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "resolvida"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "pendente"
    },
    "resposta": {
      "type": "string"
    },
    "lida": {
      "type": "boolean",
      "default": false
    },
    "criado_por_automacao": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "usuario_id",
    "titulo",
    "mensagem",
    "tipo"
  ]
}