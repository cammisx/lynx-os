{
  "name": "DesenhoFixo",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "desenho_url": {
      "type": "string",
      "description": "URL da imagem do desenho"
    },
    "nome": {
      "type": "string"
    },
    "largura": {
      "type": "number",
      "description": "Largura do widget na mesa, em pixels"
    },
    "altura": {
      "type": "number",
      "description": "Altura do widget na mesa, em pixels"
    },
    "pos_x": {
      "type": "number",
      "description": "Posicao horizontal do widget na mesa"
    },
    "pos_y": {
      "type": "number",
      "description": "Posicao vertical do widget na mesa"
    }
  },
  "required": [
    "usuario_id",
    "desenho_url"
  ]
}