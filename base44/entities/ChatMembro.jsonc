{
  "name": "ChatMembro",
  "type": "object",
  "properties": {
    "canal_id": {
      "type": "string"
    },
    "usuario_id": {
      "type": "string"
    },
    "ultima_leitura_em": {
      "type": "string"
    },
    "arquivado": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "canal_id",
    "usuario_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.usuario_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}