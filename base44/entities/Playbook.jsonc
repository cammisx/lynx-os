{
  "name": "Playbook",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": ["empresa", "modelo"],
      "default": "modelo"
    },
    "modelo_id": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "resumo": {
      "type": "string",
      "description": "Uma linha explicando para que serve este playbook"
    },
    "secoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "titulo": { "type": "string" },
          "descricao": {
            "type": "string",
            "description": "Texto explicativo que aparece abaixo do titulo da secao"
          },
          "texto": {
            "type": "string",
            "description": "Formato antigo: bloco de texto corrido. Ainda lido, mas o novo sao as perguntas"
          },
          "itens": {
            "type": "array",
            "description": "Perguntas da secao, cada uma com a resposta da modelo",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "pergunta": { "type": "string" },
                "tipo": {
                  "type": "string",
                  "enum": ["curto", "longo", "data", "radio", "checkbox"],
                  "default": "longo",
                  "description": "curto/longo: texto | data: calendario | radio: escolha unica | checkbox: varias escolhas"
                },
                "opcoes": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Alternativas das perguntas de escolha"
                },
                "outro": {
                  "type": "boolean",
                  "default": false,
                  "description": "Mostra a alternativa Outro, com campo de texto"
                },
                "obrigatoria": {
                  "type": "boolean",
                  "default": false,
                  "description": "Sem resposta, o formulario nao envia"
                },
                "resposta": { "type": "string" },
                "copiar": {
                  "type": "boolean",
                  "default": false,
                  "description": "Mostra um botao para copiar a resposta na leitura"
                }
              }
            }
          }
        }
      }
    },
    "arquivado": {
      "type": "boolean",
      "default": false
    },
    "arquivado_em": {
      "type": "string",
      "format": "date-time"
    },
    "atualizado_por": {
      "type": "string"
    },
    "atualizado_por_nome": {
      "type": "string"
    }
  },
  "required": ["tipo"]
}
