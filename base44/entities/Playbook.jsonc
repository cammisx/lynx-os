{
  "name": "Playbook",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": ["empresa", "modelo"],
      "default": "modelo"
    },
    "modelo_id": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "resumo": {
      "type": "string",
      "description": "Uma linha explicando para que serve este playbook"
    },
    "secoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "titulo": { "type": "string" },
          "texto": { "type": "string" }
        }
      }
    },
    "arquivado": {
      "type": "boolean",
      "default": false
    },
    "arquivado_em": {
      "type": "string",
      "format": "date-time"
    },
    "atualizado_por": {
      "type": "string"
    },
    "atualizado_por_nome": {
      "type": "string"
    }
  },
  "required": ["tipo"]
}
