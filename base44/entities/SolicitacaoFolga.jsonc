{
  "name": "SolicitacaoFolga",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "usuario_nome": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "modelo_id": {
      "type": "string"
    },
    "modelo_nome": {
      "type": "string"
    },
    "ocorrencia_data": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "folga",
        "reducao"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "folga"
    },
    "ajuste": {
      "type": "string",
      "enum": [
        "sair_antes",
        "entrar_depois"
      ],
      "enumColors": [
        "orange",
        "teal"
      ]
    },
    "horario_solicitado": {
      "type": "string",
      "format": "date-time"
    },
    "turno_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "turno_fim": {
      "type": "string",
      "format": "date-time"
    },
    "antecedencia_horas": {
      "type": "number"
    },
    "fora_do_prazo": {
      "type": "boolean",
      "default": false
    },
    "motivo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovada",
        "recusada"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pendente"
    },
    "revisado_por": {
      "type": "string"
    },
    "revisado_em": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_recusa": {
      "type": "string"
    }
  },
  "required": [
    "usuario_id",
    "shift_id",
    "tipo"
  ]
}
