{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "nome_exibicao": {
      "type": "string",
      "description": "Nome que o usu\u00e1rio escolheu mostrar no sistema"
    },
    "foto_url": {
      "type": "string",
      "description": "Foto de perfil (URL do upload)"
    },
    "subnick": {
      "type": "string",
      "description": "Recado curto embaixo do nome, estilo MSN"
    },
    "tema": {
      "type": "string",
      "description": "Perfil de cor do sistema escolhido pelo usu\u00e1rio"
    },
    "tema_modo": {
      "type": "string",
      "description": "Modo de cor: claro, escuro ou sistema"
    },
    "fundo_url": {
      "type": "string",
      "description": "Imagem propria usada como fundo do desktop"
    },
    "fundo_estatico": {
      "type": "boolean",
      "description": "Para a animacao da seda do fundo (modo leve)"
    },
    "pet": {
      "type": "string",
      "description": "Pet do desktop escolhido: nenhum, gato, cachorro ou morcego"
    },
    "pet_cor": {
      "type": "string",
      "description": "Cor do pelo do pet: original, preto, branco, cinza, marrom ou rosa"
    },
    "pet_nome": {
      "type": "string",
      "description": "Nome dado ao pet do desktop pelo usuario"
    },
    "tema_celular": {
      "type": "string",
      "description": "Perfil de cor usado no celular (o do computador fica em tema)"
    },
    "tema_modo_celular": {
      "type": "string",
      "description": "Modo de cor no celular: claro, escuro ou sistema"
    },
    "fonte_escala_celular": {
      "type": "string",
      "description": "Tamanho da fonte usado no celular"
    },
    "fonte_app_celular": {
      "type": "string",
      "enum": ["mono", "classica", "redonda"],
      "description": "Familia tipografica usada no celular"
    },
    "fundo_url_celular": {
      "type": "string",
      "description": "Imagem de fundo escolhida para o celular"
    },
    "fundo_estatico_celular": {
      "type": "boolean",
      "description": "Para a animacao da seda no celular"
    },
    "fundo_modo_celular": {
      "type": "string",
      "enum": ["animado", "parado", "sem"],
      "description": "Fundo no celular: animado, parado ou sem linhas"
    },
    "pet_celular": {
      "type": "string",
      "description": "Pet escolhido para o celular"
    },
    "pet_cor_celular": {
      "type": "string",
      "description": "Cor do pet no celular"
    },
    "pet_nome_celular": {
      "type": "string",
      "description": "Nome do pet no celular"
    },
    "agenda_ordem": {
      "type": "string",
      "description": "Ordem das agendas das modelos no painel do relogio (ids separados por virgula)"
    },
    "fonte_app": {
      "type": "string",
      "enum": ["mono", "classica", "redonda"],
      "description": "Familia tipografica do sistema escolhida pelo usuario"
    },
    "fundo_modo": {
      "type": "string",
      "enum": ["animado", "parado", "sem"],
      "description": "Fundo do desktop: animado, parado ou sem linhas"
    },
    "barra_ordem": {
      "type": "string",
      "description": "Ordem dos icones das janelas na barra de tarefas, separada por virgula"
    },
    "barra_fixadas": {
      "type": "string",
      "description": "Janelas fixadas na barra de tarefas, separadas por virgula"
    },
    "tutorial_pixie_desktop_visto": {
      "type": "boolean",
      "description": "Se a pessoa já viu o tutorial da Pixie no desktop (vale na conta, em qualquer aparelho)"
    },
    "jogos_config": {
      "type": "string",
      "description": "Regras e recordes dos jogos do LynxOS em JSON (vale no desktop e no celular)"
    },
    "desempenho": {
      "type": "string",
      "description": "O que está desligado no modo leve do computador, por id: blur,brilho,animacao,fundo,pet,pixie"
    },
    "desempenho_celular": {
      "type": "string",
      "description": "O que está desligado no modo leve do celular, por id: blur,brilho,animacao,fundo,pet,pixie"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}